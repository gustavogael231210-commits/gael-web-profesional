# Variables públicas (se incrustan en el build). Configúralas también en Netlify/Vercel.

# URL pública del sitio, sin barra final (p. ej. https://www.tudominio.mx).
# Se usa para las etiquetas Open Graph. Vacía = rutas relativas.
VITE_SITE_URL=

# Escena 3D de Spline (archivo .splinecode exportado desde Spline > Export > Code).
# Vacía = se usa la sala 3D construida con CSS (recomendado si no tienes una escena propia).
VITE_SPLINE_SCENE_URL=
